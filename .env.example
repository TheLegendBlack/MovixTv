# Movix TV — modèle du fichier .env du site (Vite).
# Copier en .env (gitignoré) et renseigner les valeurs. Toutes les variables
# sont lues au build : relancer `npm run dev` / `npm run tv` après modification.
#
# ⚠️ Le schéma https:// est obligatoire sur les URL d'API : normalizeBaseUrl
# (src/config/runtime.ts) ne fait qu'un trim, il n'ajoute aucun schéma.

# === Obligatoires ===

# API principale Movix (catalogue, sources, playlist). Service de production
# distant, pas dans ce dépôt ; localhost:3000 est dans son allowlist CORS.
VITE_MAIN_API=https://api.movix.men

# Extraction des hébergeurs (voe, uqload, vidzy, fsvid, vidmoly, sibnet,
# doodstream, seekstreaming). Exige la clé VIP en en-tête `x-access-key`.
VITE_PROXIES_EMBED_API=https://proxiesembed.movix.men

# Clé API TMDB (v3), pour les affiches et fiches : https://www.themoviedb.org/settings/api
# Développement seulement : un build public l'inclurait dans le bundle. En
# ligne, chaque téléviseur la saisit dans Paramètres, Clé TMDB.
VITE_TMDB_API_KEY=

# Clé VIP personnelle. En développement seulement, src/main.tsx la pose dans
# localStorage['access_code'] de la WebView ; le bloc disparaît des builds de
# production. Ne jamais la committer.
VITE_DEV_ACCESS_CODE=

# URL publique du site. En développement : le Vite du poste, que la TV joint
# par `adb reverse` (npm run tv). En production : l'adresse HTTPS où le site
# est hébergé (voir app/README.md, « Portage en APK autonome »).
VITE_SITE_URL=http://localhost:3000


# === Optionnelles (repli du service worker, valeurs par défaut du dépôt) ===
# Miroirs figés au build si rentry.co est injoignable : hostnames séparés par
# des virgules, sans protocole ni slash.
VITE_DEFAULT_MIRRORS=movix.health
# Config distante des miroirs : JSON {"mirrors":[...]} ou page rentry.co/<slug>.
VITE_MIRRORS_CONFIG_URL=https://rentry.co/movix

# === Héritées du site web, sans effet dans l'interface TV ===
# Lues par du code partagé avec le site amont (Turnstile, watch party, régie
# publicitaire, analytics) qui n'est plus monté sur les 4 routes TV. Laisser
# vide.
VITE_WATCHPARTY_API=
VITE_TURNSTILE_SITE_KEY=
VITE_TURNSTILE_INVISIBLE_SITEKEY=
VITE_SUPPORT_TELEGRAM_URL=
VITE_AD_DIRECT_URLS_ADULT=
VITE_AD_DIRECT_URL_SFW=
VITE_AD_SCRIPT_SRC=
VITE_SWIFTFLUX_AD_URL=
VITE_ANALYTICS_PROVIDER=none
